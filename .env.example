# MongoDB Atlas — Atlas paneli > Connect > Drivers bölməsindən götürülür.
# Sonda baza adını yazmağı unutma: .../nextstage?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://ISTIFADECI:PAROL@cluster0.xxxxx.mongodb.net/nextstage?retryWrites=true&w=majority"

# Admin paneli (/admin)
# Hesablar bazadadır, env-də deyil. İlk admini terminaldan yarat:
#   npm run admin:add -- e-poct@numune.az 'parol'
# Sonrakıları /admin/adminler səhifəsindən əlavə et.
#
# Sessiya cookie-sini imzalayan açar, ən azı 32 simvol:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SESSION_SECRET=""

# Saytın açıq ünvanı (Vercel-də domen ilə əvəzlənir)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
